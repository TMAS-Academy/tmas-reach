# Server Runtime
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_PER_SEC=8
SCHEDULER_INTERVAL_MS=15000
LOG_LEVEL=info

# Persistence (SQLite WAL file path; omit for in-memory mode)
SQLITE_DB_PATH=./data/tmas-reach.sqlite

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/tmas_reach
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
AUTH_SECRET=your-auth-secret

# Email Service Provider (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=outreach@example.com

# Webhook
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret
